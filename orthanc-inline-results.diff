diff --git a/frontend/src/dashboard/hooks/useSeriesReview.js b/frontend/src/dashboard/hooks/useSeriesReview.js
new file mode 100644
index 0000000000000000000000000000000000000000..136c98dc34fcb66634ab5019b961ca744a9311d3
--- /dev/null
+++ b/frontend/src/dashboard/hooks/useSeriesReview.js
@@ -0,0 +1,113 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useSearchParams } from "react-router-dom";
+import { useSnackbar } from "notistack";
+import { useDashboard } from "../context/DashboardContext";
+import { useRerunReviewQueue } from "../context/RerunReviewContext";
+import { requestReview } from "../utils/reviewApi";
+import { reviewMatchesSeries, selectReviewId } from "../utils/choResultFlow";
+
+export default function useSeriesReview() {
+  const { choModal, actions } = useDashboard();
+  const { pending, pollError, resolveReview } = useRerunReviewQueue();
+  const { enqueueSnackbar } = useSnackbar();
+  const [searchParams, setSearchParams] = useSearchParams();
+  const pendingReview = pending.find((item) => reviewMatchesSeries(item, choModal)) ?? null;
+  const requestedId = searchParams.get("review");
+  const id = selectReviewId({ pending, series: choModal, requestedId });
+  const key = JSON.stringify([choModal.seriesId, choModal.seriesUuid, id]);
+  const [state, setState] = useState({ key: null, review: null, error: "" });
+  const [reload, setReload] = useState(0);
+  const [saving, setSaving] = useState(false);
+  const lock = useRef(false);
+  const mounted = useRef(false);
+  const selection = useRef(key);
+  selection.current = key;
+  const matchingState = state.key === key ? state : null;
+  const review = matchingState?.review ?? null;
+  const error = matchingState?.error ?? "";
+  const loading = Boolean(id && !review && !error);
+
+  useEffect(() => {
+    mounted.current = true;
+    return () => { mounted.current = false; };
+  }, []);
+
+  useEffect(() => {
+    if (!id || !choModal.seriesId) return undefined;
+    const controller = new AbortController();
+    const load = async () => {
+      setState({ key, review: null, error: "" });
+      try {
+        const data = await requestReview(`/${encodeURIComponent(id)}`, { signal: controller.signal });
+        if (data?.id !== id || data.state !== "ready" || !data.candidate?.results || !data.baseline) {
+          throw new Error("The rerun is not ready for review.");
+        }
+        if (!reviewMatchesSeries(data, { seriesId: choModal.seriesId, seriesUuid: choModal.seriesUuid })) {
+          throw new Error("This review does not belong to the selected series.");
+        }
+        if (!controller.signal.aborted) setState({ key, review: data, error: "" });
+      } catch (failure) {
+        if (!controller.signal.aborted) setState({ key, review: null, error: failure.message });
+      }
+    };
+    load();
+    return () => controller.abort();
+  }, [id, key, choModal.seriesId, choModal.seriesUuid, reload]);
+
+  const openReview = useCallback(() => {
+    if (!pendingReview) return;
+    setSearchParams((previous) => {
+      const next = new URLSearchParams(previous);
+      next.set("review", pendingReview.id);
+      return next;
+    });
+  }, [pendingReview, setSearchParams]);
+
+  const decide = useCallback(async (decision) => {
+    if (!review || lock.current || !["overwrite", "discard"].includes(decision)) return;
+    lock.current = true;
+    setSaving(true);
+    setState({ key, review, error: "" });
+    try {
+      await requestReview(`/${encodeURIComponent(review.id)}`, {
+        method: "POST", body: JSON.stringify({ decision }),
+      });
+    } catch (failure) {
+      // Keep the candidate available on conflicts, network errors, and save failures.
+      if (mounted.current && selection.current === key) setState({ key, review, error: failure.message });
+      lock.current = false;
+      if (mounted.current) setSaving(false);
+      return;
+    }
+
+    resolveReview(review.id);
+    window.dispatchEvent(new CustomEvent("ctpro-review-resolved", {
+      detail: { seriesUuid: review.series_uuid, decision },
+    }));
+    enqueueSnackbar(decision === "overwrite" ? "Reviewed results saved." : "New results discarded. Saved results were kept.", { variant: "success" });
+    try {
+      // A POST continues if the user leaves; its completion must not reset another exam.
+      if (mounted.current && selection.current === key) {
+        setState({ key: null, review: null, error: "" });
+        setSearchParams((previous) => {
+          const next = new URLSearchParams(previous);
+          if (next.get("review") === review.id) next.delete("review");
+          return next;
+        }, { replace: true });
+        const refreshed = await actions.reloadStoredChoResults({ clearResults: true });
+        if (refreshed === false && mounted.current) {
+          enqueueSnackbar("Decision applied. Reload the saved results to refresh this page.", { variant: "warning" });
+        }
+      }
+    } finally {
+      lock.current = false;
+      if (mounted.current) setSaving(false);
+    }
+  }, [review, key, resolveReview, enqueueSnackbar, setSearchParams, actions]);
+
+  return {
+    review, pendingReview, loading, error, saving, pollError,
+    requested: Boolean(id), openReview, decide,
+    retry: () => setReload((value) => value + 1),
+  };
+}
diff --git a/frontend/src/dashboard/utils/choResultFlow.js b/frontend/src/dashboard/utils/choResultFlow.js
new file mode 100644
index 0000000000000000000000000000000000000000..a263d2937a3412a6b6876b8563ecc22ee451c42c
--- /dev/null
+++ b/frontend/src/dashboard/utils/choResultFlow.js
@@ -0,0 +1,88 @@
+// Presentation policy only. The server remains authoritative for saving/review.
+const present = (value) => value !== null && value !== undefined && value !== "";
+const same = (left, right) => present(left) && present(right) && String(left) === String(right);
+
+export const reviewMatchesSeries = (review, series) => {
+  if (!review || !series) return false;
+  // Prefer the DICOM UID when both sides have one; do not match conflicting UIDs.
+  if (present(review.series_uid) && present(series.seriesId)) {
+    return same(review.series_uid, series.seriesId);
+  }
+  return same(review.series_uuid, series.seriesUuid);
+};
+
+export const reviewResultsUrl = (review) => {
+  if (!present(review?.series_uid) || !present(review?.id)) {
+    throw new Error("The review has no series UID or review ID.");
+  }
+  return `/results/${encodeURIComponent(review.series_uid)}?review=${encodeURIComponent(review.id)}#analysis-results`;
+};
+
+export const selectReviewId = ({ pending, series, requestedId }) => {
+  if (requestedId) return requestedId;
+  if (series?.runMode !== "foreground") return null;
+  return pending.find((review) => reviewMatchesSeries(review, series))?.id ?? null;
+};
+
+export const shouldNotifyReview = (review, series, requestedId) => {
+  if (!series?.open || !reviewMatchesSeries(review, series)) return true;
+  return series.runMode !== "foreground" && requestedId !== review.id;
+};
+
+export const candidatePlotData = (candidate) => candidate ? ({
+  ...candidate,
+  // The accepted MinIO image must not be represented as a candidate image.
+  series_instance_uid: undefined,
+  series: { ...candidate.series, series_instance_uid: undefined },
+}) : null;
+
+export const applyChoProgress = (previous, entry) => {
+  if (!previous.open || !previous.runMode || previous.stage !== "running" || !entry) {
+    return previous;
+  }
+  const id = entry.series_id ?? entry.series_uuid ?? entry.seriesId;
+  if (!same(id, previous.seriesUuid) && !same(id, previous.seriesId)) return previous;
+  const event = entry.eventType ?? (
+    entry.status === "completed" ? "completed" :
+    ["failed", "error", "cancelled"].includes(entry.status) ? "failed" : "progress"
+  );
+  if (!["start", "progress", "completed", "failed"].includes(event)) return previous;
+
+  const runId = entry.metadata?.run_id;
+  if (runId && (runId === previous.previousRunId || (previous.runId && runId !== previous.runId))) {
+    return previous;
+  }
+  const reviewRequired = entry.metadata?.review_required ?? previous.reviewRequired ?? false;
+  const common = { ...previous, runId: runId ?? previous.runId, reviewRequired };
+  if (event === "completed") {
+    return {
+      ...common,
+      stage: previous.runMode === "foreground" ? "results" : "config",
+      // Reruns are read from the review endpoint only, after staging completes.
+      // Never inject a background completion's payload into the visible page.
+      results: previous.runMode === "foreground" && !reviewRequired ? entry.results ?? null : null,
+      progress: { value: 100, message: entry.message ?? "Calculation completed", stage: "completed" },
+      pollError: null,
+    };
+  }
+  if (event === "failed") {
+    return {
+      ...common, stage: "config", runMode: null, results: null,
+      pollError: entry.error ?? entry.message ?? "Calculation failed",
+      progress: { ...previous.progress, message: entry.message ?? "Calculation failed", stage: "error" },
+    };
+  }
+  return {
+    ...common,
+    progress: {
+      value: typeof entry.progress === "number" ? entry.progress : previous.progress?.value ?? 0,
+      message: entry.message ?? previous.progress?.message ?? "Processing...",
+      stage: entry.current_stage ?? previous.progress?.stage ?? "initialization",
+    },
+  };
+};
+
+export const backgroundChoRun = (previous) => previous.runMode === "foreground" ? ({
+  ...previous, runMode: "background", results: null,
+  stage: previous.stage === "running" ? "running" : "config",
+}) : previous;
diff --git a/frontend/src/dashboard/utils/reviewApi.js b/frontend/src/dashboard/utils/reviewApi.js
new file mode 100644
index 0000000000000000000000000000000000000000..5cba1500635b54350f20362f3fefa6e672cdb1ee
--- /dev/null
+++ b/frontend/src/dashboard/utils/reviewApi.js
@@ -0,0 +1,22 @@
+const apiBase = (import.meta.env?.VITE_API_URL ?? "").replace(/\/$/, "");
+
+export async function requestReview(path = "", options = {}) {
+  const response = await fetch(`${apiBase}/cho-result-reviews${path}`, {
+    credentials: "include", cache: "no-store", ...options,
+    headers: { ...(options.body ? { "Content-Type": "application/json" } : {}), ...options.headers },
+  });
+  let payload;
+  try {
+    payload = await response.json();
+  } catch {
+    const error = new Error(`Invalid review response (${response.status}).`);
+    error.status = response.status;
+    throw error;
+  }
+  if (!response.ok) {
+    const error = new Error(payload?.error || `Review request failed (${response.status}).`);
+    error.status = response.status;
+    throw error;
+  }
+  return payload;
+}
diff --git a/frontend/tests/choResultFlow.test.mjs b/frontend/tests/choResultFlow.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7554594644151d7999c30b3a53902289a9c3b5ae
